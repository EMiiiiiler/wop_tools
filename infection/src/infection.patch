-	if (g_gametype.integer >= GT_TEAM) {
+	if (G_Infection()) {
+		// one pool of players: the mode moves them between the teams (and parks the first infected as spectators)
+		if (minplayers >= g_maxclients.integer) {
+			minplayers = g_maxclients.integer - 1;
+		}
