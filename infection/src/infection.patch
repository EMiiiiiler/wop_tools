+/*
+==================
+BotInfectionHuntGoal
+
+An infected bot has nothing to collect: its long term goal is the survivor it can reach fastest
+==================
+*/
+static int BotInfectionHuntGoal(bot_state_t *bs, int tfl, bot_goal_t *goal) {
+	static int huntTarget[MAX_CLIENTS];
+	static float huntTime[MAX_CLIENTS];
+	vec3_t pos, dir;
+	int i, t, areanum, best, bestTime;
+
+	if (!INF_IsInfected(g_entities[bs->client].client))
+		return qfalse;
+
+	// anybody the bot sees is known to all infected
+	if (bs->enemy >= 0 && bs->enemy < MAX_CLIENTS && INF_IsSurvivor(bs->enemy))
+		INF_Reveal(bs->enemy);
+
+	best = huntTarget[bs->client] - 1;
+	if (best >= 0 && (huntTime[bs->client] < FloatTime() || !INF_KnownPosition(best, pos)))
+		best = -1;
+
+	if (best < 0) {
+		bestTime = 0;
+		for (i = 0; i < level.maxclients; i++) {
+			if (!INF_KnownPosition(i, pos))
+				continue;
+			areanum = BotPointAreaNum(pos);
+			if (!areanum || !trap_AAS_AreaReachability(areanum))
+				continue;
+			t = trap_AAS_AreaTravelTimeToGoalArea(bs->areanum, bs->origin, areanum, tfl);
+			if (!t)
+				continue;
+			if (best < 0 || t < bestTime) {
+				best = i;
+				bestTime = t;
+			}
+		}
+		huntTarget[bs->client] = best + 1;
+		huntTime[bs->client] = FloatTime() + 2;
+		if (best < 0)
+			return qfalse; // no idea where anybody is: roam the map like in a normal match
+	}
+
+	INF_KnownPosition(best, pos);
+	areanum = BotPointAreaNum(pos);
+	if (!areanum || !trap_AAS_AreaReachability(areanum)) {
+		huntTarget[bs->client] = 0;
+		return qfalse;
+	}
+
+	// arrived and nobody here (the bot would be fighting otherwise): the trail is cold
+	VectorSubtract(pos, bs->origin, dir);
+	if (g_inf_botAwareness.integer && VectorLengthSquared(dir) < Square(90) &&
+		!BotEntityVisible(bs->entitynum, bs->eye, bs->viewangles, 360, best)) {
+		INF_ForgetPosition(best);
+		huntTarget[bs->client] = 0;
+		return qfalse;
+	}
+
+	memset(goal, 0, sizeof(*goal));
+	goal->entitynum = best;
+	goal->areanum = areanum;
+	VectorCopy(pos, goal->origin);
+	VectorSet(goal->mins, -8, -8, -8);
+	VectorSet(goal->maxs, 8, 8, 8);
+	return qtrue;
+}
+
+/*
+==================
+Infection: survivor bots hold a position
+
+g_inf_botHoldLead seconds before the infected are released, every survivor bot stops shopping and either escorts a
+human survivor (g_inf_botEscort bots per human seek them out) or walks to a hold spot and stays there. Any other
+survivor bot that sees a human survivor joins the group too (g_inf_botJoinOnSight). Hold spots are the best
+"defensible" item places of the map: health stations, armour, power-ups and weapons, the higher up the better,
+at least 700 units apart, three bots per spot.
+==================
+*/
+#define INF_MAX_HOLDSPOTS 8
+#define INF_HOLDSPOT_BOTS 3
+#define INF_HOLDSPOT_SEPARATION 700.0f
+
+typedef struct {
+	vec3_t origin;
+	int areanum;
+	int entitynum;
+	int users;
+} infHoldSpot_t;
+
+static infHoldSpot_t infHoldSpots[INF_MAX_HOLDSPOTS];
+static int infNumHoldSpots;
+static int infHoldSpotsRound;
+static int infHoldRound[MAX_CLIENTS]; // round the bot's assignment was made in
+static int infHoldMate[MAX_CLIENTS];  // client number + 1 of the escorted human, 0 = holds a spot
+static int infHoldSpot[MAX_CLIENTS];  // index into infHoldSpots, -1 = none
+static bot_goal_t infHoldGoal[MAX_CLIENTS];
+static int infHoldArrived[MAX_CLIENTS]; // round the bot first stood in position (for the log)
+static float infHoldLook[MAX_CLIENTS];	// next time a spot holder looks out for a human to join
+
+static float BotInfectionHoldSpotValue(const gentity_t *ent) {
+	if (!ent->inuse || (ent->flags & FL_DROPPED_ITEM))
+		return 0;
+	if (ent->classname && !Q_stricmp(ent->classname, "station_health"))
+		return 3.0f;
+	if (ent->s.eType != ET_ITEM || !ent->item)
+		return 0;
+	switch (ent->item->giType) {
+	case IT_ARMOR:
+		return 2.0f;
+	case IT_POWERUP:
+		return 1.5f;
+	case IT_WEAPON:
+	case IT_HOLDABLE:
+		return 1.0f;
+	default:
+		return 0;
+	}
+}
+
+static void BotInfectionFindHoldSpots(void) {
+	int i, k, wanted, bots = 0;
+	float minz = 0, maxz = 0;
+	qboolean any = qfalse;
+
+	infNumHoldSpots = 0;
+	for (i = 0; i < level.maxclients; i++) {
+		if (INF_IsSurvivor(i) && !INF_IsHumanPlayer(i))
+			bots++;
+	}
+	wanted = (bots + INF_HOLDSPOT_BOTS - 1) / INF_HOLDSPOT_BOTS;
+	if (wanted < 1)
+		wanted = 1;
+	if (wanted > INF_MAX_HOLDSPOTS)
+		wanted = INF_MAX_HOLDSPOTS;
+
+	for (i = MAX_CLIENTS; i < level.num_entities; i++) {
+		const gentity_t *ent = &g_entities[i];
+		if (BotInfectionHoldSpotValue(ent) <= 0)
+			continue;
+		if (!any || ent->r.currentOrigin[2] < minz)
+			minz = ent->r.currentOrigin[2];
+		if (!any || ent->r.currentOrigin[2] > maxz)
+			maxz = ent->r.currentOrigin[2];
+		any = qtrue;
+	}
+	if (!any)
+		return;
+
+	for (k = 0; k < wanted; k++) {
+		int best = -1, bestArea = 0;
+		float bestScore = 0;
+
+		for (i = MAX_CLIENTS; i < level.num_entities; i++) {
+			gentity_t *ent = &g_entities[i];
+			float score = BotInfectionHoldSpotValue(ent);
+			int j, areanum;
+
+			if (score <= 0)
+				continue;
+			// high ground is worth as much as a health station
+			score += 3.0f * (ent->r.currentOrigin[2] - minz) / (maxz - minz + 1.0f);
+			if (best >= 0 && score <= bestScore)
+				continue;
+			for (j = 0; j < infNumHoldSpots; j++) {
+				if (Distance(ent->r.currentOrigin, infHoldSpots[j].origin) < INF_HOLDSPOT_SEPARATION)
+					break;
+			}
+			if (j < infNumHoldSpots)
+				continue;
+			areanum = BotPointAreaNum(ent->r.currentOrigin);
+			if (!areanum || !trap_AAS_AreaReachability(areanum))
+				continue;
+			best = i;
+			bestScore = score;
+			bestArea = areanum;
+		}
+		if (best < 0)
+			break;
+		VectorCopy(g_entities[best].r.currentOrigin, infHoldSpots[infNumHoldSpots].origin);
+		infHoldSpots[infNumHoldSpots].areanum = bestArea;
+		infHoldSpots[infNumHoldSpots].entitynum = best;
+		infHoldSpots[infNumHoldSpots].users = 0;
+		infNumHoldSpots++;
+		G_LogPrintf("InfectionHoldSpot: %i %s %i %i %i\n", infNumHoldSpots, g_entities[best].classname,
+					(int)g_entities[best].r.currentOrigin[0], (int)g_entities[best].r.currentOrigin[1],
+					(int)g_entities[best].r.currentOrigin[2]);
+	}
+}
+
+static void BotInfectionPickHoldSpot(bot_state_t *bs, int tfl) {
+	int i, pass, best = -1, bestTime = 0;
+
+	// first pass: spots with room, second pass: any spot
+	for (pass = 0; pass < 2 && best < 0; pass++) {
+		for (i = 0; i < infNumHoldSpots; i++) {
+			int t;
+			if (!pass && infHoldSpots[i].users >= INF_HOLDSPOT_BOTS)
+				continue;
+			t = trap_AAS_AreaTravelTimeToGoalArea(bs->areanum, bs->origin, infHoldSpots[i].areanum, tfl);
+			if (!t)
+				continue;
+			if (best < 0 || t < bestTime) {
+				best = i;
+				bestTime = t;
+			}
+		}
+	}
+	infHoldSpot[bs->client] = best;
+	if (best >= 0)
+		infHoldSpots[best].users++;
+}
+
+static void BotInfectionAssignHold(bot_state_t *bs, int tfl, int round) {
+	int i, j;
+
+	infHoldRound[bs->client] = round;
+	infHoldMate[bs->client] = 0;
+	infHoldSpot[bs->client] = -1;
+	memset(&infHoldGoal[bs->client], 0, sizeof(infHoldGoal[0]));
+
+	// escort a human survivor who still lacks company
+	for (i = 0; i < level.maxclients; i++) {
+		int escorts = 0;
+
+		if (i == bs->client || !INF_IsSurvivor(i) || !INF_IsHumanPlayer(i) || g_entities[i].health <= 0)
+			continue;
+		for (j = 0; j < level.maxclients; j++) {
+			if (j != bs->client && infHoldRound[j] == round && infHoldMate[j] == i + 1 && INF_IsSurvivor(j))
+				escorts++;
+		}
+		if (escorts < g_inf_botEscort.integer) {
+			infHoldMate[bs->client] = i + 1;
+			G_LogPrintf("InfectionHold: %i escort %i\n", bs->client, i);
+			return;
+		}
+	}
+	BotInfectionPickHoldSpot(bs, tfl);
+	G_LogPrintf("InfectionHold: %i spot %i\n", bs->client, infHoldSpot[bs->client] + 1);
+}
+
+/*
+returns 0 = not holding (normal goals), 1 = goal set, 2 = in position: stand and watch
+*/
+static int BotInfectionHoldGoal(bot_state_t *bs, int tfl, bot_goal_t *goal) {
+	int round, areanum;
+	float standDist, horiz;
+	vec3_t target, dir;
+	qboolean escort = qfalse;
+
+	round = INF_HoldRound();
+	if (!round || !INF_IsSurvivor(bs->client))
+		return 0;
+
+	if (infHoldSpotsRound != round) {
+		infHoldSpotsRound = round;
+		BotInfectionFindHoldSpots();
+	}
+	if (infHoldRound[bs->client] != round)
+		BotInfectionAssignHold(bs, tfl, round);
+
+	// a bot on its way to a spot, or holding one, joins a human survivor it sees: the group defends together
+	if (!infHoldMate[bs->client] && g_inf_botJoinOnSight.integer && infHoldLook[bs->client] < FloatTime()) {
+		int i;
+
+		infHoldLook[bs->client] = FloatTime() + 1;
+		for (i = 0; i < level.maxclients; i++) {
+			if (i == bs->client || !INF_IsSurvivor(i) || !INF_IsHumanPlayer(i) || g_entities[i].health <= 0)
+				continue;
+			if (!BotEntityVisible(bs->entitynum, bs->eye, bs->viewangles, 360, i))
+				continue;
+			if (infHoldSpot[bs->client] >= 0)
+				infHoldSpots[infHoldSpot[bs->client]].users--;
+			infHoldSpot[bs->client] = -1;
+			infHoldMate[bs->client] = i + 1;
+			infHoldArrived[bs->client] = 0;
+			G_LogPrintf("InfectionHold: %i join %i\n", bs->client, i);
+			break;
+		}
+	}
+
+	if (infHoldMate[bs->client]) {
+		int mate = infHoldMate[bs->client] - 1;
+		gentity_t *ent = &g_entities[mate];
+
+		if (!INF_IsSurvivor(mate) || !ent->inuse || !ent->client || ent->health <= 0) {
+			// the human is infected or gone: fall back to a spot
+			infHoldMate[bs->client] = 0;
+			BotInfectionPickHoldSpot(bs, tfl);
+		} else {
+			escort = qtrue;
+			VectorCopy(ent->client->ps.origin, target);
+			standDist = 110.0f + 40.0f * (bs->client % 5); // a loose ring round the human, not a queue
+			areanum = BotPointAreaNum(target);
+			if (areanum && trap_AAS_AreaReachability(areanum)) {
+				memset(&infHoldGoal[bs->client], 0, sizeof(infHoldGoal[0]));
+				infHoldGoal[bs->client].entitynum = mate;
+				infHoldGoal[bs->client].areanum = areanum;
+				VectorCopy(target, infHoldGoal[bs->client].origin);
+				VectorSet(infHoldGoal[bs->client].mins, -8, -8, -8);
+				VectorSet(infHoldGoal[bs->client].maxs, 8, 8, 8);
+			}
+		}
+	}
+
+	if (!escort) {
+		infHoldSpot_t *spot;
+
+		if (infHoldSpot[bs->client] < 0)
+			return 0;
+		spot = &infHoldSpots[infHoldSpot[bs->client]];
+		VectorCopy(spot->origin, target);
+		standDist = 70.0f + 50.0f * (bs->client % 3);
+		memset(&infHoldGoal[bs->client], 0, sizeof(infHoldGoal[0]));
+		infHoldGoal[bs->client].entitynum = spot->entitynum;
+		infHoldGoal[bs->client].areanum = spot->areanum;
+		VectorCopy(spot->origin, infHoldGoal[bs->client].origin);
+		VectorSet(infHoldGoal[bs->client].mins, -8, -8, -8);
+		VectorSet(infHoldGoal[bs->client].maxs, 8, 8, 8);
+	}
+
+	if (!infHoldGoal[bs->client].areanum)
+		return 0; // the human has not stood on reachable ground yet
+
+	VectorSubtract(target, bs->origin, dir);
+	horiz = sqrt(dir[0] * dir[0] + dir[1] * dir[1]);
+	if (horiz < standDist && fabs(dir[2]) < 72 &&
+		(!escort || BotEntityVisible(bs->entitynum, bs->eye, bs->viewangles, 360, infHoldMate[bs->client] - 1))) {
+		// in position: look around for the infected
+		if (infHoldArrived[bs->client] != round) {
+			infHoldArrived[bs->client] = round;
+			G_LogPrintf("InfectionHold: %i inposition\n", bs->client);
+		}
+		if (random() < bs->thinktime * 0.8f) {
+			vec3_t look;
+			BotRoamGoal(bs, look);
+			VectorSubtract(look, bs->origin, dir);
+			vectoangles(dir, bs->ideal_viewangles);
+			bs->ideal_viewangles[2] *= 0.5;
+		}
+		trap_BotResetAvoidReach(bs->ms);
+		return 2;
+	}
+
+	memcpy(goal, &infHoldGoal[bs->client], sizeof(*goal));
+	return 1;
+}
